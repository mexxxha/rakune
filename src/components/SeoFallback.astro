---
import { artworkAlt, homeTitle } from '../lib/seo';
import type { Portfolio } from '../lib/types';

interface Props {
  portfolio: Portfolio;
}

const { portfolio } = Astro.props;
const { works, profile } = portfolio;
---

<noscript>
  <style>
    body {
      overflow: auto;
      height: auto;
      background: #fff;
      color: #111;
      font-family: "Yu Gothic UI", "Yu Gothic", "Hiragino Sans", "Meiryo", sans-serif;
    }

    .os,
    .boot {
      display: none !important;
    }

    .fallback {
      max-width: 880px;
      margin: 0 auto;
      padding: 32px 20px 64px;
    }

    .fallback h1 {
      font-size: 28px;
      margin-bottom: 12px;
    }

    .fallback__bio {
      white-space: pre-wrap;
      line-height: 1.7;
      margin-bottom: 28px;
    }

    .fallback h2 {
      font-size: 20px;
      margin: 28px 0 12px;
    }

    .fallback__works {
      display: grid;
      gap: 28px;
    }

    .fallback figure {
      margin: 0;
    }

    .fallback img {
      display: block;
      width: min(100%, 640px);
      height: auto;
    }

    .fallback figcaption {
      margin-top: 8px;
      line-height: 1.6;
    }

    .fallback figcaption strong {
      display: block;
    }

    .fallback a {
      color: #000080;
    }

    .fallback li + li {
      margin-top: 6px;
    }
  </style>
  <article class="fallback">
    <h1>{homeTitle}</h1>
    <p class="fallback__bio">{profile.bio}</p>
    <h2>作品</h2>
    <div class="fallback__works">
      {
        works.map((work) => (
          <figure>
            <img src={work.image} alt={artworkAlt(work)} />
            <figcaption>
              <strong>
                {work.title}
                {work.year ? `（${work.year}）` : ''}
              </strong>
              {work.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
    <h2>連絡先</h2>
    <ul>
      {
        profile.links.map((link) => (
          <li>
            <a href={link.url}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </article>
</noscript>
